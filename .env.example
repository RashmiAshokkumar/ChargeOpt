# Shared environment template
# Copy this file to .env in the respective app folder as needed.

# Backend (backend/.env)
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave DATABASE_URL unset for local dev (falls back to sqlite3 in backend/db.sqlite3).
# In production (Render/Railway), set it to the Postgres connection string the
# platform provides, e.g. postgres://user:pass@host:5432/dbname
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend (frontend/.env.local)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
